{
  "openapi": "3.0.3",
  "info": {
    "title": "Insight-Service",
    "version": "0.3.0",
    "description": "Authorized BI reads, durable conversation history, and stateless per-turn chat/reanalysis through the pinned ML API. Conversations are stored in Insight PostgreSQL and are never sent to ML."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Service process is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Database ping and BI/ML metadata probes succeeded"
          },
          "503": {
            "description": "Storage or an upstream is unavailable"
          }
        }
      }
    },
    "/v1/feed": {
      "get": {
        "summary": "Read a company's BI feed",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^(24h|([1-9][0-9]*d))$"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "company",
                "all"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "high_risk",
                "opportunity",
                "unaccounted",
                "not_analyzed"
              ]
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rank",
                "published_at"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "BI CompanyView JSON, preserved without dropping card fields"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied access"
          },
          "422": {
            "description": "BI rejected parameters"
          },
          "502": {
            "description": "BI failure"
          }
        }
      }
    },
    "/v1/cards/{card_id}": {
      "get": {
        "summary": "Read a full BI card",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full BI card JSON, including ml_card"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied access"
          },
          "404": {
            "description": "Card not found"
          },
          "502": {
            "description": "BI failure"
          }
        }
      }
    },
    "/v1/companies/{company_uuid}/contexts/{context_version}": {
      "get": {
        "summary": "Read the exact BI-stored company context snapshot",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "company_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "context_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored company context JSON"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied access"
          },
          "404": {
            "description": "Context not found"
          },
          "502": {
            "description": "BI failure"
          }
        }
      }
    },
    "/v1/conversations": {
      "post": {
        "summary": "Create an owned conversation",
        "description": "BI authorization is checked before storage. The Idempotency-Key is durable and global across create, chat, and reanalyze operations.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation metadata created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or key"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied current membership"
          },
          "409": {
            "description": "Idempotency key reused for another operation"
          },
          "503": {
            "description": "Conversation storage unavailable"
          }
        }
      },
      "get": {
        "summary": "List owned conversations",
        "description": "BI authorization is checked before reading storage. The stable cursor sorts by created_at and conversation_id.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Opaque stable continuation cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied current membership"
          },
          "503": {
            "description": "Conversation storage unavailable"
          }
        }
      }
    },
    "/v1/conversations/{conversation_id}": {
      "get": {
        "summary": "Read owned conversation metadata",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied current membership"
          },
          "404": {
            "description": "Conversation is missing or not owned by current BI identity/role"
          },
          "503": {
            "description": "Conversation storage unavailable"
          }
        }
      }
    },
    "/v1/conversations/{conversation_id}/history": {
      "get": {
        "summary": "Read a bounded page of conversation turns",
        "description": "History is durable in Insight PostgreSQL, owner-scoped, and not passed to ML. Expired abandoned turns are lazily marked outcome_unknown without re-execution. A response stays within the configured byte bound; an oversized single turn returns 413.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after_sequence",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered turn page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryPage"
                }
              }
            }
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "BI denied current membership"
          },
          "404": {
            "description": "Conversation is missing or not owned by current BI identity/role"
          },
          "413": {
            "description": "One stored turn exceeds the configured page byte limit"
          },
          "503": {
            "description": "Conversation storage unavailable"
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "summary": "Answer a question using the current authorized company context and optional card",
        "description": "BI revalidates membership and any selected conversation/card before the durable idempotency lookup. Each message is sent alone to the existing ML endpoint; conversation history and conversation_id are never sent to ML. Storage does not make ML execution distributed exactly-once.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing ML chat fields with provenance and conversation_id",
            "headers": {
              "X-Conversation-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous request"
          },
          "401": {
            "description": "Missing or invalid Bearer subject"
          },
          "403": {
            "description": "BI denied current company membership"
          },
          "409": {
            "description": "BI/ML context conflict or idempotency key reuse"
          },
          "413": {
            "description": "Request body too large"
          },
          "415": {
            "description": "Content-Type must be application/json"
          },
          "502": {
            "description": "BI/ML contract or upstream failure"
          },
          "504": {
            "description": "ML outcome unknown; same key/body replays this result without retry"
          }
        }
      }
    },
    "/v1/cards/{card_id}/reanalyze": {
      "post": {
        "summary": "Rebuild the currently authorized ML card through its existing rebuild endpoint",
        "description": "BI card revision is checked and never changed by Insight. ML rebuild is not synchronized back into BI; later reads can see the previous BI version and return 409. Timeout or inconsistent mutation response is outcome_unknown and is not retried automatically.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReanalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native ML card and before/after provenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReanalyzeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous request"
          },
          "401": {
            "description": "Missing or invalid Bearer subject"
          },
          "403": {
            "description": "BI denied current company membership"
          },
          "404": {
            "description": "BI card not found"
          },
          "409": {
            "description": "BI/ML context conflict or idempotency key reuse"
          },
          "413": {
            "description": "Request body too large"
          },
          "415": {
            "description": "Content-Type must be application/json"
          },
          "502": {
            "description": "BI/ML contract or upstream failure"
          },
          "504": {
            "description": "Mutation outcome unknown; same key/body replays this result without retry"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CreateConversationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_id"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Conversation": {
        "type": "object",
        "required": [
          "conversation_id",
          "company_id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "company_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConversationPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Conversation"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "HistoryTurn": {
        "type": "object",
        "required": [
          "sequence",
          "message",
          "status",
          "created_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "card_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "context_version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "outcome_unknown"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "response": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "HistoryPage": {
        "type": "object",
        "required": [
          "conversation",
          "turns"
        ],
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/Conversation"
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            }
          },
          "next_after_sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_id",
          "message"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "description": "Allowed only when card_id is provided."
          },
          "context_version": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional owned conversation to append to. Omit to create a new conversation for this turn."
          }
        }
      },
      "ReanalyzeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_id",
          "revision"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "context_version": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "Provenance": {
        "type": "object",
        "required": [
          "company_id",
          "company_external_id",
          "bi_context_version",
          "ml_context_version",
          "checked_at",
          "exact_snapshot_guaranteed",
          "bi_sync_status"
        ],
        "properties": {
          "company_id": {
            "type": "string",
            "format": "uuid"
          },
          "company_external_id": {
            "type": "string"
          },
          "bi_context_version": {
            "type": "string"
          },
          "bi_revision": {
            "type": "integer"
          },
          "bi_card_id": {
            "type": "string"
          },
          "ml_context_version": {
            "type": "string"
          },
          "ml_card_version": {
            "type": "integer"
          },
          "ml_card_version_before": {
            "type": "integer"
          },
          "ml_card_version_after": {
            "type": "integer"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "exact_snapshot_guaranteed": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "bi_sync_status": {
            "type": "string",
            "enum": [
              "not_requested"
            ]
          },
          "bi_revision_unchanged": {
            "type": "boolean"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "replyId",
          "createdAt",
          "content",
          "citations",
          "trace",
          "provenance",
          "conversation_id"
        ],
        "properties": {
          "replyId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "trace": {
            "type": "object",
            "additionalProperties": true
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": true
      },
      "ReanalyzeResponse": {
        "type": "object",
        "required": [
          "card",
          "provenance"
        ],
        "properties": {
          "card": {
            "type": "object",
            "additionalProperties": true
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
