{
  "$defs": {
    "AICompanyContext": {
      "additionalProperties": false,
      "description": "Снимок фактов; роль передаётся отдельно в команде.",
      "properties": {
        "company": {
          "$ref": "#/$defs/Company"
        },
        "payments": {
          "$ref": "#/$defs/PaymentSummary"
        },
        "top_counterparties": {
          "items": {
            "$ref": "#/$defs/Counterparty"
          },
          "title": "Top Counterparties",
          "type": "array"
        },
        "counterparties_total": {
          "title": "Counterparties Total",
          "type": "integer"
        },
        "data_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Data Warnings",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "ml_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanyMLContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "company",
        "payments",
        "top_counterparties",
        "counterparties_total",
        "data_warnings",
        "sources"
      ],
      "title": "AICompanyContext",
      "type": "object"
    },
    "BusinessProfile": {
      "additionalProperties": false,
      "description": "Дополнение пользователем. Факты CSV этим профилем не перезаписываются.",
      "properties": {
        "sales_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/SalesModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_sales_channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimarySalesChannel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tax_regime": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxRegime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_vulnerability": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyVulnerability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seasonality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seasonality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ceo_goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/CEOGoal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BusinessProfile",
      "type": "object"
    },
    "CEOGoal": {
      "description": "Цель комапнии на год.",
      "enum": [
        "Aggressive_Growth_Scaling",
        "Maintaining_Market_Position_Cost_Optimization",
        "Achieving_Profitability_Resolving_Cash_Flow_Issues"
      ],
      "title": "CEOGoal",
      "type": "string"
    },
    "Company": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Синтетическое отображаемое название; null допустим только в исторических событиях до обогащения",
          "title": "Name"
        },
        "profile_status": {
          "enum": [
            "available",
            "missing",
            "conflicting"
          ],
          "title": "Profile Status",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/CompanyProfile"
        },
        "business_profile": {
          "$ref": "#/$defs/BusinessProfile"
        },
        "conflicting_fields": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Fields",
          "type": "array"
        },
        "profile_variants": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Profile Variants",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "external_id",
        "profile_status",
        "profile",
        "business_profile",
        "conflicting_fields",
        "profile_variants",
        "updated_at"
      ],
      "title": "Company",
      "type": "object"
    },
    "CompanyMLContext": {
      "additionalProperties": false,
      "properties": {
        "revenue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Выручка компании для ML; значения <=1000 считаются неизвестными",
          "title": "Revenue"
        },
        "group_revenue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сумма известных выручек группы; null, если ни одной известной нет",
          "title": "Group Revenue"
        },
        "group_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Число компаний группы, кроме исключённого U_428697; null без GROUP_ID",
          "title": "Group Size"
        },
        "group_revenue_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Известна ли выручка всех компаний группы; null без GROUP_ID",
          "title": "Group Revenue Complete"
        },
        "is_large": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Известная выручка группы >15 млрд; false только при полной выручке, иначе null",
          "title": "Is Large"
        },
        "excluded_from_ml": {
          "default": false,
          "title": "Excluded From Ml",
          "type": "boolean"
        },
        "aggregation_version": {
          "const": 1,
          "default": 1,
          "title": "Aggregation Version",
          "type": "integer"
        },
        "buyers": {
          "$ref": "#/$defs/CounterpartyExposure"
        },
        "suppliers": {
          "$ref": "#/$defs/CounterpartyExposure"
        }
      },
      "required": [
        "buyers",
        "suppliers"
      ],
      "title": "CompanyMLContext",
      "type": "object"
    },
    "CompanyProfile": {
      "description": "Факты исходного набора. Пропуск означает неизвестное значение, а не ноль.",
      "properties": {
        "org_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Org Type"
        },
        "okfs_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okfs Name"
        },
        "company_age_years_gradation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company Age Years Gradation"
        },
        "eco_mark_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eco Mark Label"
        },
        "mainokved_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mainokved Code"
        },
        "mainokved_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mainokved Name"
        },
        "negativemark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Признак ключевого собственника согласно ТЗ; исходное поле NEGATIVEMARK",
          "title": "Negativemark"
        },
        "amount_workers_fns_gradation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Workers Fns Gradation"
        },
        "amount_workers_spark_gradation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Workers Spark Gradation"
        },
        "cl_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cl Type"
        },
        "cl_product_rko_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Расчётно-кассовое обслуживание",
          "title": "Cl Product Rko Mark"
        },
        "cl_product_gar_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Банковские гарантии",
          "title": "Cl Product Gar Mark"
        },
        "cl_product_loa_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Кредитные продукты",
          "title": "Cl Product Loa Mark"
        },
        "cl_product_lea_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Лизинг",
          "title": "Cl Product Lea Mark"
        },
        "cl_product_dep_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Депозиты",
          "title": "Cl Product Dep Mark"
        },
        "cl_product_zpp_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Зарплатный проект",
          "title": "Cl Product Zpp Mark"
        },
        "fts_flag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fts Flag"
        },
        "fts_country_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fts Country Name"
        },
        "factoring_mark": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factoring Mark"
        },
        "revenue_company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Company"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "global_sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "readOnly": true,
          "title": "Global Sector"
        }
      },
      "required": [
        "global_sector"
      ],
      "title": "CompanyProfile",
      "type": "object"
    },
    "Counterparty": {
      "properties": {
        "company_id": {
          "format": "uuid",
          "title": "Company Id",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Синтетическое название; отсутствие допустимо в исторических ML-снимках",
          "title": "Name"
        },
        "profile_status": {
          "title": "Profile Status",
          "type": "string"
        },
        "mainokved_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mainokved Code"
        },
        "mainokved_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mainokved Name"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "incoming_amount": {
          "title": "Incoming Amount",
          "type": "string"
        },
        "incoming_count": {
          "title": "Incoming Count",
          "type": "integer"
        },
        "outgoing_amount": {
          "title": "Outgoing Amount",
          "type": "string"
        },
        "outgoing_count": {
          "title": "Outgoing Count",
          "type": "integer"
        }
      },
      "required": [
        "company_id",
        "external_id",
        "profile_status",
        "incoming_amount",
        "incoming_count",
        "outgoing_amount",
        "outgoing_count"
      ],
      "title": "Counterparty",
      "type": "object"
    },
    "CounterpartyExposure": {
      "description": "Все внешние платежи одного направления с учётом исключений для ML; валюта сумм не предполагается.",
      "properties": {
        "total_amount": {
          "title": "Total Amount",
          "type": "string"
        },
        "count": {
          "description": "Число уникальных контрагентов, а не количество платежей",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "top1_share": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Доля крупнейшего контрагента; null при нулевой сумме",
          "title": "Top1 Share"
        },
        "known_share": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Доля суммы с определённым разделом ОКВЭД; null при нулевой сумме",
          "title": "Known Share"
        },
        "sections": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Доли общей суммы по разделам ОКВЭД A–U; включая все разделы, не только топ",
          "title": "Sections",
          "type": "object"
        }
      },
      "required": [
        "total_amount",
        "count",
        "top1_share",
        "known_share",
        "sections"
      ],
      "title": "CounterpartyExposure",
      "type": "object"
    },
    "KeyVulnerability": {
      "description": "Основной фактор риска.",
      "enum": [
        "Import_Exchange_Rate",
        "High_Reliance_Loans_Leasing"
      ],
      "title": "KeyVulnerability",
      "type": "string"
    },
    "NewsSelection": {
      "additionalProperties": false,
      "properties": {
        "lookback_hours": {
          "default": 168,
          "maximum": 8760,
          "minimum": 1,
          "title": "Lookback Hours",
          "type": "integer"
        },
        "max_news": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Max News",
          "type": "integer"
        }
      },
      "title": "NewsSelection",
      "type": "object"
    },
    "PaymentSummary": {
      "description": "Агрегаты исходного набора. Даты и валюта в исходных данных не заданы.",
      "properties": {
        "company_id": {
          "format": "uuid",
          "title": "Company Id",
          "type": "string"
        },
        "incoming_amount": {
          "title": "Incoming Amount",
          "type": "string"
        },
        "incoming_count": {
          "title": "Incoming Count",
          "type": "integer"
        },
        "outgoing_amount": {
          "title": "Outgoing Amount",
          "type": "string"
        },
        "outgoing_count": {
          "title": "Outgoing Count",
          "type": "integer"
        },
        "self_amount": {
          "title": "Self Amount",
          "type": "string"
        },
        "self_count": {
          "title": "Self Count",
          "type": "integer"
        },
        "source_rows": {
          "title": "Source Rows",
          "type": "integer"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "period_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Start"
        },
        "period_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        }
      },
      "required": [
        "company_id",
        "incoming_amount",
        "incoming_count",
        "outgoing_amount",
        "outgoing_count",
        "self_amount",
        "self_count",
        "source_rows"
      ],
      "title": "PaymentSummary",
      "type": "object"
    },
    "PrimarySalesChannel": {
      "description": "Основной канал продаж.",
      "enum": [
        "marketplace"
      ],
      "title": "PrimarySalesChannel",
      "type": "string"
    },
    "SalesModel": {
      "description": "Модель продаж по типу клиента.",
      "enum": [
        "B2B",
        "B2C",
        "B2G"
      ],
      "title": "SalesModel",
      "type": "string"
    },
    "Seasonality": {
      "description": "Сезонность бизнеса.",
      "enum": [
        "Steady_Year",
        "Summer/Spring_Peak",
        "Winter/Autumn_Peak"
      ],
      "title": "Seasonality",
      "type": "string"
    },
    "TaxRegime": {
      "description": "Форма налогооблажения.",
      "enum": [
        "OSNO",
        "USN",
        "ESXH",
        "PSN",
        "NPD",
        "AUSN"
      ],
      "title": "TaxRegime",
      "type": "string"
    },
    "UserRole": {
      "enum": [
        "собственник бизнеса",
        "генеральный директор",
        "финансовый директор",
        "главный бухгалтер",
        "руководитель казначейства",
        "другие руководители"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "event_type": {
      "const": "company.ai-preparation.requested",
      "default": "company.ai-preparation.requested",
      "title": "Event Type",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "requested_by": {
      "format": "uuid",
      "title": "Requested By",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "context_version": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Version",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/NewsSelection"
    },
    "context": {
      "$ref": "#/$defs/AICompanyContext"
    }
  },
  "required": [
    "event_id",
    "request_id",
    "company_id",
    "requested_by",
    "role",
    "context_version",
    "selection",
    "context"
  ],
  "title": "AIPreparationRequested",
  "type": "object",
  "x-invariants": [
    "event_id=request_id",
    "company_id=context.company.id=context.payments.company_id",
    "context_version=sha256 of canonical context"
  ],
