{
  "$defs": {
    "PreparationError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PreparationError",
      "type": "object"
    },
    "PreparationResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "news_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Revision",
          "type": "string"
        },
        "pipeline_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "news_revision",
        "pipeline_version",
        "generated_at"
      ],
      "title": "PreparationResult",
      "type": "object"
    },
    "UserRole": {
      "enum": [
        "собственник бизнеса",
        "генеральный директор",
        "финансовый директор",
        "главный бухгалтер",
        "руководитель казначейства",
        "другие руководители"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "company.ai-preparation.completed",
        "company.ai-preparation.failed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "context_version": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Version",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparationError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "event_type",
    "version",
    "occurred_at",
    "request_id",
    "company_id",
    "role",
    "context_version"
  ],
  "title": "AIPreparationFinished",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "company.ai-preparation.completed"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/PreparationResult"
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "result"
        ]
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/PreparationError"
          },
          "result": {
            "type": "null"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
