{
  "$defs": {
    "ProcessedArticle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "news_id": {
          "format": "uuid",
          "title": "News Id",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "importance": {
          "maximum": 5,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "okved_sections": {
          "items": {
            "type": "string"
          },
          "title": "Okved Sections",
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "countries": {
          "items": {
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "templates": {
          "items": {
            "$ref": "#/$defs/TemplateHit"
          },
          "title": "Templates",
          "type": "array"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/Sentence"
          },
          "title": "Sentences",
          "type": "array"
        }
      },
      "required": [
        "news_id",
        "event_id",
        "title",
        "url",
        "published_at",
        "source",
        "summary",
        "importance",
        "sentences"
      ],
      "title": "ProcessedArticle",
      "type": "object"
    },
    "Sentence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "news",
            "alfa",
            "company",
            "template",
            "profile",
            "calc"
          ],
          "title": "Kind",
          "type": "string"
        },
        "doc": {
          "title": "Doc",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        }
      },
      "required": [
        "id",
        "kind",
        "doc",
        "text"
      ],
      "title": "Sentence",
      "type": "object"
    },
    "TableValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "TableValue",
      "type": "object"
    },
    "TemplateHit": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "minimum": 1,
          "title": "Template Version",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "table": {
          "items": {
            "$ref": "#/$defs/TableValue"
          },
          "title": "Table",
          "type": "array"
        }
      },
      "required": [
        "template_id",
        "template_version",
        "confidence"
      ],
      "title": "TemplateHit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "news.article.processed",
      "title": "Event Type",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "article": {
      "$ref": "#/$defs/ProcessedArticle"
    },
    "cards": {
      "items": {
        "type": "string"
      },
      "title": "Cards",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "version",
    "article"
  ],
  "title": "NativeArticleProcessed",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Снимок принимающей модели BI для фактического news.article.processed.v1 ML 0.3. cards содержит ID, а не объекты."
}
