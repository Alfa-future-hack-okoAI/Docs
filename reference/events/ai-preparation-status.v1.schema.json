{
  "$defs": {
    "PreparationDelivery": {
      "properties": {
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        }
      },
      "title": "PreparationDelivery",
      "type": "object"
    },
    "PreparationError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PreparationError",
      "type": "object"
    },
    "PreparationResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "news_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Revision",
          "type": "string"
        },
        "pipeline_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Pipeline Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "news_revision",
        "pipeline_version",
        "generated_at"
      ],
      "title": "PreparationResult",
      "type": "object"
    },
    "UserRole": {
      "enum": [
        "собственник бизнеса",
        "генеральный директор",
        "финансовый директор",
        "главный бухгалтер",
        "руководитель казначейства",
        "другие руководители"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "description": "Статус запроса; сами сводки и инсайты принадлежат ML-модулю.",
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "requested_by": {
      "format": "uuid",
      "title": "Requested By",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "context_version": {
      "title": "Context Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "queued",
        "ready",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "delivery": {
      "$ref": "#/$defs/PreparationDelivery"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparationError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "idempotency_key",
    "requested_by",
    "company_id",
    "role",
    "context_version",
    "status",
    "created_at",
    "delivery"
  ],
  "title": "AIPreparation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
